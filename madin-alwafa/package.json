{
  "name": "madin-alwafa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistem informasi Madrasah Diniyah Al-Wafa: data santri dan santriwati, absensi, nilai, hafalan, syahriah, pengumuman, dan raport online untuk wali santri.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "demo": "NODE_ENV=production tsx server/demo.ts",
    "demo:ulang": "NODE_ENV=production tsx server/demo.ts --ulang",
    "test": "node --import tsx --test server/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node tests/e2e.mjs",
    "pratinjau": "node scripts/pratinjau.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.2.8",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@hono/node-server": "1.19.17",
    "better-sqlite3": "12.4.1",
    "hono": "4.13.13",
    "lucide-react": "1.49.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.8",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.25.10",
    "playwright": "^1.63.0",
    "sql.js": "^1.14.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
